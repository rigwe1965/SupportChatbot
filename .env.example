DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportchatbot?schema=public"

NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Embeddings for the knowledge base (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=""

# Slack escalation: use a bot token + channel ID (preferred) OR an incoming webhook URL
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
SLACK_WEBHOOK_URL=""

# Escalate after this many consecutive low-confidence answers (1 = on the first miss)
ESCALATION_MAX_FAILED_ATTEMPTS="2"
# Best-match similarity below this counts as "not confident"
ESCALATION_MIN_SIMILARITY="0.35"

# Comma-separated emails that are promoted to ADMIN on sign-in
ADMIN_EMAILS=""
