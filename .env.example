# ─────────────────────────────────────────────────────────────
# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.
# [required] must be set · [optional] has a default or is skippable
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL with the pgvector extension) ────────
# [required] Runtime connection. On Neon/Vercel use the POOLED url (host contains "-pooler")
# and append `&pgbouncer=true&connect_timeout=15`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportchatbot?schema=public"
# [required] Direct (non-pooled) connection, used by `prisma migrate`. Locally: same as DATABASE_URL.
# On Vercel/Neon this is the "unpooled" url (DATABASE_URL_UNPOOLED).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/supportchatbot?schema=public"

# ── NextAuth ─────────────────────────────────────────────────
# [required in production] Public URL of the site, no trailing slash, e.g. https://support.example.com
NEXTAUTH_URL="http://localhost:3000"
# [required] Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# [required: at least one provider]
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers (one callback URL per app → use a separate app per environment)
#   Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# [optional] Comma-separated emails promoted to ADMIN when they sign in
ADMIN_EMAILS=""

# ── OpenAI ───────────────────────────────────────────────────
# [required] Used for embeddings and chat
OPENAI_API_KEY=""
# [optional] defaults: gpt-4o-mini / text-embedding-3-small (changing the embedding model
# requires 1536 dimensions, then "Regenerate all embeddings" in the admin)
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# ── Rate limiting (per signed-in user, applies to /api/chat and /api/chat/retrieve) ──
# [optional] Max messages per minute / per hour. Returns HTTP 429 with a Retry-After header.
RATE_LIMIT_CHAT_PER_MINUTE="10"
RATE_LIMIT_CHAT_PER_HOUR="100"

# ── Slack escalation ─────────────────────────────────────────
# [optional] Bot token + channel ID (preferred; bot needs chat:write and must be invited to the channel)…
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
# …or an Incoming Webhook URL
SLACK_WEBHOOK_URL=""

# ── Email notifications for new tickets (via https://resend.com) ──
# [optional] API key. Without it, no emails are sent.
RESEND_API_KEY=""
# [optional] Sender. Use an address on a domain you've verified in Resend. The default
# onboarding@resend.dev only delivers to your own Resend account email (fine for testing).
EMAIL_FROM="SupportChatbot <support@yourdomain.com>"
# [optional] Comma-separated recipients for new-ticket emails. Defaults to ADMIN_EMAILS.
TICKET_NOTIFY_EMAILS=""

# ── Escalation tuning ────────────────────────────────────────
# [optional] Escalate after this many consecutive low-confidence answers (1 = on the first miss)
ESCALATION_MAX_FAILED_ATTEMPTS="2"
# [optional] Best-match similarity below this counts as "not confident"
ESCALATION_MIN_SIMILARITY="0.35"
